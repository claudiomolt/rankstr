# ---------------------------------------------------------------- Lightning
# LUD16 Lightning Address that receives every bid. This is the only payment
# configuration rankstr needs: the server resolves
# https://{domain}/.well-known/lnurlp/{name}, requests a BOLT11 through the
# LUD06 callback, and confirms settlement against the LUD21 verify URL that
# callback returns.
#
# When LN_ADDRESS is unset the board runs on a labelled mock rail: invoices are
# simulated, no sats move, and the dev "mock pay" button is enabled. Setting
# LN_ADDRESS disables mock pay entirely.
#
# There is no client-side payment secret. Nothing here is exposed to browsers.
# LN_ADDRESS=rankstr@your-lightning-provider.example

# Public network label used in copy and in the mock invoice prefix.
NEXT_PUBLIC_NETWORK=mainnet

# ----------------------------------------------------------------- Database
# Postgres. When unset the board uses an in-process store seeded from
# src/lib/seed.ts, which is fine for local development and lost on restart.
# Apply drizzle/*.sql in order, then optionally: DATABASE_URL=… npm run db:seed
# DATABASE_URL=postgres://user:pass@host:5432/rankstr

# -------------------------------------------------------------------- Nostr
# Relays for the read-only kind 0 profile lookup used to enrich listings that
# carry an npub. Comma-separated wss:// URLs. No NIP-07, no signing, no spend.
# Defaults when unset:
#   wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
