# Public network label for Lightning copy / mock invoice prefix.
# Live LSP should use mainnet.
NEXT_PUBLIC_NETWORK=mainnet

# Postgres (optional). When unset, board uses in-memory seed; bids persist in a process Map.
# DATABASE_URL=postgres://user:pass@host:5432/rankstr

# Hosted LSP / Voltage-style LND REST (optional).
# When EITHER is absent → mock invoices only (dev). No spend.
# Assumed create endpoint: POST {LN_LSP_BASE_URL}/v1/invoices
#   Headers: Grpc-Metadata-macaroon + Authorization Bearer {LN_LSP_API_KEY}
# LN_LSP_BASE_URL=https://your-node.m.voltageapp.io:8080
# LN_LSP_API_KEY=

# Webhook shared secret for POST /api/webhooks/ln (required when live LSP configured).
# Send via x-webhook-secret or Authorization: Bearer …
# LN_WEBHOOK_SECRET=

# Optional Nostr relays (P4)
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
